<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.universidad.controller.AdminDashboardController"
            styleClass="root-pane">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
            <Label text="🎓 Panel Administrador" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion" styleClass="btn-logout"/>
        </HBox>
    </top>
 <!-- CONTENT: TabPane -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tabpane">

            <!-- ── TAB ALUMNOS ── -->
            <Tab text="👨‍🎓  Alumnos">
                <SplitPane dividerPositions="0.55">
                    <!-- Tabla -->
                    <VBox spacing="8" styleClass="tab-section">
                        <Label text="Lista de alumnos" styleClass="section-title"/>
                        <TableView fx:id="tablaAlumnos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colAlNombre" text="Nombre" prefWidth="160"/>
                                <TableColumn fx:id="colAlMatricula" text="Matrícula" prefWidth="100"/>
                                <TableColumn fx:id="colAlCarrera" text="Carrera" prefWidth="180"/>
                                <TableColumn fx:id="colAlCorreo" text="Correo" prefWidth="180"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <!-- Formulario -->
                    <VBox spacing="12" styleClass="form-panel">
                        <Label text="Nuevo / Editar alumno" styleClass="section-title"/>
                        <Label text="Nombre completo" styleClass="form-label"/>
                        <TextField fx:id="txtAlNombre" promptText="Nombre completo" styleClass="form-input"/>
                        <Label text="Correo" styleClass="form-label"/>
                        <TextField fx:id="txtAlCorreo" promptText="correo@uni.edu" styleClass="form-input"/>
                        <Label text="Matrícula" styleClass="form-label"/>
                        <TextField fx:id="txtAlMatricula" promptText="2024001" styleClass="form-input"/>
                        <Label text="Contraseña (dejar vacío para no cambiar)" styleClass="form-label"/>
                        <PasswordField fx:id="txtAlPass" promptText="••••••••" styleClass="form-input"/>
                        <Label text="Carrera" styleClass="form-label"/>
                        <ComboBox fx:id="cmbAlCarrera" maxWidth="Infinity"/>
                        <HBox spacing="8">
                            <Button text="Nuevo" onAction="#onNuevoAlumno" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Guardar" onAction="#onGuardarAlumno" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Eliminar" onAction="#onEliminarAlumno" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- ── TAB PROFESORES ── -->
            <Tab text="👨‍🏫  Profesores">
                <SplitPane dividerPositions="0.55">
                    <VBox spacing="8" styleClass="tab-section">
                        <Label text="Lista de profesores" styleClass="section-title"/>
                        <TableView fx:id="tablaProfesores" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPrNombre" text="Nombre" prefWidth="200"/>
                                <TableColumn fx:id="colPrEmpleado" text="Núm. Empleado" prefWidth="130"/>
                                <TableColumn fx:id="colPrCorreo" text="Correo" prefWidth="200"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="12" styleClass="form-panel">
                        <Label text="Nuevo / Editar profesor" styleClass="section-title"/>
                        <Label text="Nombre" styleClass="form-label"/>
                        <TextField fx:id="txtPrNombre" promptText="Dr. Nombre Apellido" styleClass="form-input"/>
                        <Label text="Correo" styleClass="form-label"/>
                        <TextField fx:id="txtPrCorreo" promptText="prof@uni.edu" styleClass="form-input"/>
                        <Label text="Número de empleado" styleClass="form-label"/>
                        <TextField fx:id="txtPrEmpleado" promptText="EMP-001" styleClass="form-input"/>
                        <Label text="Contraseña" styleClass="form-label"/>
                        <PasswordField fx:id="txtPrPass" promptText="••••••••" styleClass="form-input"/>
                        <HBox spacing="8">
                            <Button text="Nuevo" onAction="#onNuevoProfesor" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Guardar" onAction="#onGuardarProfesor" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Eliminar" onAction="#onEliminarProfesor" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>

            <!-- ── TAB CARRERAS ── -->
            <Tab text="🏫  Carreras">
                <SplitPane dividerPositions="0.55">
                    <VBox spacing="8" styleClass="tab-section">
                        <Label text="Carreras registradas" styleClass="section-title"/>
                        <TableView fx:id="tablaCarreras" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCarNombre" text="Nombre de la Carrera" prefWidth="350"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="12" styleClass="form-panel">
                        <Label text="Nueva / Editar carrera" styleClass="section-title"/>
                        <Label text="Nombre" styleClass="form-label"/>
                        <TextField fx:id="txtCarNombre" promptText="Ingeniería en Sistemas" styleClass="form-input"/>
                        <HBox spacing="8">
                            <Button text="Guardar" onAction="#onGuardarCarrera" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Eliminar" onAction="#onEliminarCarrera" styleClass="btn-danger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </SplitPane>
            </Tab>
