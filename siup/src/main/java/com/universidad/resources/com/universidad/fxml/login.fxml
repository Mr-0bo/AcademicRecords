<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.universidad.controller.LoginController"
           styleClass="root-pane">

    <VBox alignment="CENTER" spacing="0" maxWidth="400" maxHeight="480"
          styleClass="login-card">

        <VBox alignment="CENTER" spacing="8" styleClass="login-header">
            <Label text="🎓" style="-fx-font-size: 48px;"/>
            <Label text="Sistema Universitario" styleClass="login-title"/>
            <Label text="Gestión de Calificaciones" styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="16" styleClass="login-form">
            <Label text="Correo electrónico" styleClass="form-label"/>
            <TextField fx:id="txtCorreo" promptText="usuario@universidad.edu"
                       styleClass="form-input"/>

            <Label text="Contraseña" styleClass="form-label"/>
            <PasswordField fx:id="txtContrasena" promptText="••••••••"
                           styleClass="form-input"/>
<Button text="Ingresar al sistema"
                    styleClass="btn-primary"
                    maxWidth="Infinity"
                    onAction="#onIngresar" />
        </VBox>

        <VBox alignment="CENTER" spacing="4" styleClass="login-hint">
            <Label text="Credenciales de prueba:" styleClass="hint-title"/>
            <Label text="admin@uni.edu  /  alumno@uni.edu  /  profesor@uni.edu" styleClass="hint-text"/>
            <Label text="Contraseña de todas: admin123" styleClass="hint-text"/>
        </VBox>

    </VBox>
</StackPane>
